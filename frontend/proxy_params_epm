proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
# Overwrite (don't append): $remote_addr is already the real visitor IP (see real_ip in nginx.conf),
# and the API trusts the first X-Forwarded-For entry, so a client-supplied value must never pass through.
proxy_set_header X-Forwarded-For $remote_addr;
# Cloudflare terminates HTTPS; keep the visitor's scheme rather than nginx's internal http.
proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
