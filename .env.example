# ─────────────────────────────────────────────────────────────────────────────
# EPM System configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# Used by the FastAPI backend (directly) and by docker-compose (substitution).
# ─────────────────────────────────────────────────────────────────────────────

# development | production
ENVIRONMENT=development
# Public URL users open in the browser; used for links in e-mails.
APP_BASE_URL=http://localhost:5173

# Random string, at least 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Database (MySQL 8+) ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pm_db1
DB_USER=pm_user
DB_PASS=
# docker-compose only: root password for the bundled MySQL container
MYSQL_ROOT_PASSWORD=

# ── SMTP (password-reset & invite e-mails) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Password Reset
SMTP_STARTTLS=true

# ── SMTP for Bill of Materials e-mails (Preventive Maintenance mailbox) ──────
# Finalized BOMs are e-mailed to the store from this account. If unset, the BOM is
# still finalized and the app shows the secure link to copy and send manually.
BOM_SMTP_HOST=
BOM_SMTP_PORT=587
BOM_SMTP_USERNAME=
BOM_SMTP_PASSWORD=
BOM_SMTP_FROM_EMAIL=
BOM_SMTP_FROM_NAME=Preventive Maintenance
BOM_SMTP_STARTTLS=true
# Days the PDF link in a BOM e-mail stays valid
BOM_LINK_DAYS=30

# ── Tokens & security ────────────────────────────────────────────────────────
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
# Password reset links (minutes) — keep between 30 and 60
PASSWORD_RESET_MINUTES=45
INVITE_TOKEN_HOURS=72
MAX_FAILED_LOGINS=10
LOCKOUT_MINUTES=15
# Leave unset: Secure cookies are enabled automatically when ENVIRONMENT=production.
# COOKIE_SECURE=true

# ── Uploads ──────────────────────────────────────────────────────────────────
# Relative paths are resolved from the project root.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200

# Only if the frontend is served from a different origin than /api:
# CORS_ORIGINS=https://app.example.com
